<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TamraLife – Pure Copper. Pure Life.</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@200;300;400;500&display=swap" rel="stylesheet">
<style>
:root {
  --copper:#b5722a; --copper-light:#d4924a; --copper-dark:#8a5018;
  --green:#4a7c4e; --cream:#faf6f1; --warm-white:#fff9f4;
  --dark:#1a1510; --dark-mid:#2e2418; --text-body:#3d2f1f;
  --text-muted:#8c7355; --border:rgba(181,114,42,0.2);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Jost',sans-serif;background:var(--cream);color:var(--text-body);overflow-x:hidden}

/* ── TICKER ── */
.ticker-bar{
  position:fixed;top:0;left:0;right:0;z-index:200;
  background:var(--copper);padding:0.38rem 0;overflow:hidden;
  height:32px;display:flex;align-items:center;
}
.ticker-track{
  display:flex;gap:4rem;white-space:nowrap;
  animation:tickerScroll 28s linear infinite;
}
.ticker-track span{
  font-size:0.68rem;font-weight:300;letter-spacing:0.18em;
  text-transform:uppercase;color:rgba(255,255,255,0.88);
}
.ticker-dot{color:rgba(255,255,255,0.4)!important;font-size:0.5rem}
@keyframes tickerScroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* ── NAV ── */
nav{
  position:fixed;top:32px;left:0;right:0;z-index:100;
  display:flex;align-items:center;justify-content:space-between;
  padding:1.1rem 5%;
  background:rgba(250,246,241,0.92);backdrop-filter:blur(18px);
  border-bottom:1px solid var(--border);
}
.nav-logo{font-family:'Cormorant Garamond',serif;font-size:1.6rem;font-weight:600;letter-spacing:0.04em;color:var(--dark)}
.nav-logo span{color:var(--green)}
.nav-links{display:flex;gap:2rem;list-style:none}
.nav-links a{font-size:0.76rem;font-weight:400;letter-spacing:0.14em;text-transform:uppercase;text-decoration:none;color:var(--text-muted);transition:color .3s}
.nav-links a:hover{color:var(--copper)}
.nav-cta{font-size:0.73rem;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;text-decoration:none;color:var(--copper);border:1px solid var(--copper);padding:.5rem 1.4rem;transition:background .3s,color .3s}
.nav-cta:hover{background:var(--copper);color:#fff}

/* ── HERO ── */
.hero{
  min-height:100vh;
  background:linear-gradient(160deg,#1a1510 0%,#2e2418 45%,#3d2f1f 100%);
  display:grid;grid-template-columns:1fr 1fr;align-items:center;
  position:relative;overflow:hidden;padding-top:calc(32px + 70px);
}
.hero::before{
  content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse at 65% 50%,rgba(181,114,42,.18) 0%,transparent 65%);
}
/* copper noise texture overlay */
.hero::after{
  content:'';position:absolute;inset:0;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='1'/%3E%3C/svg%3E");
  opacity:0.03;pointer-events:none;
}
.hero-watermark{position:absolute;right:-2%;top:50%;transform:translateY(-50%);font-family:'Cormorant Garamond',serif;font-size:36vw;font-weight:300;color:rgba(181,114,42,.04);line-height:1;user-select:none;pointer-events:none}
.hero-content{padding:4rem 6% 6rem 8%;position:relative;z-index:2;animation:fadeUp 1.1s ease both}
.hero-tag{font-size:.7rem;font-weight:400;letter-spacing:.28em;text-transform:uppercase;color:var(--copper-light);display:flex;align-items:center;gap:.8rem;margin-bottom:2rem}
.hero-tag::before{content:'';display:block;width:36px;height:1px;background:var(--copper-light)}
.hero h1{font-family:'Cormorant Garamond',serif;font-size:clamp(3rem,5vw,5.5rem);font-weight:300;line-height:1.08;color:#f5ede2;margin-bottom:1.8rem}
.hero h1 em{font-style:italic;color:var(--copper-light)}
.hero-sub{font-size:.9rem;font-weight:300;line-height:1.9;color:rgba(245,237,226,.6);max-width:420px;margin-bottom:2.8rem}
.hero-btns{display:flex;gap:1rem;flex-wrap:wrap}
.btn-primary{font-size:.75rem;font-weight:500;letter-spacing:.2em;text-transform:uppercase;text-decoration:none;background:var(--copper);color:#fff;padding:.85rem 2.2rem;transition:background .3s,transform .2s;display:inline-block;cursor:pointer;border:none;font-family:'Jost',sans-serif}
.btn-primary:hover{background:var(--copper-dark);transform:translateY(-2px)}
.btn-outline{font-size:.75rem;font-weight:400;letter-spacing:.2em;text-transform:uppercase;text-decoration:none;border:1px solid rgba(245,237,226,.35);color:rgba(245,237,226,.75);padding:.85rem 2.2rem;transition:border-color .3s,color .3s;display:inline-block}
.btn-outline:hover{border-color:var(--copper-light);color:var(--copper-light)}
.hero-visual{display:flex;align-items:center;justify-content:center;position:relative;z-index:2;padding:4rem 8% 6rem 2%;animation:fadeIn 1.4s ease both .3s}

/* water fill bottle */
.bottle-wrap{position:relative;width:200px;height:380px}
.bottle-svg{width:100%;height:100%}
.water-fill{
  transition:height 1.2s cubic-bezier(.4,0,.2,1),y 1.2s cubic-bezier(.4,0,.2,1);
}
.bottle-ring{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:300px;height:300px;border:1px solid rgba(181,114,42,.25);border-radius:50%;animation:spin 30s linear infinite}
.bottle-ring::before{content:'';position:absolute;width:8px;height:8px;background:var(--copper);border-radius:50%;top:-4px;left:50%;transform:translateX(-50%)}
.bottle-ring2{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:340px;height:340px;border:1px solid rgba(181,114,42,.12);border-radius:50%;animation:spin 20s linear infinite reverse}
.bottle-label{position:absolute;bottom:-50px;left:50%;transform:translateX(-50%);white-space:nowrap;text-align:center}
.bottle-label p{font-size:.65rem;letter-spacing:.22em;text-transform:uppercase;color:rgba(181,114,42,.6)}

.scroll-cue{position:absolute;bottom:2.5rem;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:.5rem;font-size:.65rem;letter-spacing:.2em;text-transform:uppercase;color:rgba(181,114,42,.6);animation:bob 2s ease-in-out infinite}
.scroll-cue::after{content:'';width:1px;height:40px;background:linear-gradient(to bottom,rgba(181,114,42,.6),transparent)}

/* ── SOCIAL PROOF STRIP ── */
.proof-strip{
  background:var(--warm-white);padding:1.6rem 8%;
  display:flex;align-items:center;justify-content:space-between;
  gap:2rem;flex-wrap:wrap;
  border-bottom:1px solid var(--border);
}
.proof-item{display:flex;align-items:center;gap:.8rem}
.proof-num{font-family:'Cormorant Garamond',serif;font-size:2rem;font-weight:300;color:var(--copper)}
.proof-text{font-size:.75rem;font-weight:300;line-height:1.4;color:var(--text-muted);letter-spacing:.04em}
.proof-divider{width:1px;height:36px;background:var(--border)}

/* ── ABOUT ── */
.about{background:var(--warm-white);padding:8rem 8%;display:grid;grid-template-columns:1fr 1fr;gap:6rem;align-items:center}
.section-tag{font-size:.7rem;font-weight:400;letter-spacing:.28em;text-transform:uppercase;color:var(--copper);display:flex;align-items:center;gap:.8rem;margin-bottom:1.4rem}
.section-tag::before{content:'';width:28px;height:1px;background:var(--copper)}
.section-title{font-family:'Cormorant Garamond',serif;font-size:clamp(2.2rem,3.5vw,3.6rem);font-weight:300;line-height:1.15;color:var(--dark);margin-bottom:1.6rem}
.section-title em{font-style:italic;color:var(--copper)}
.about-body p{font-size:.93rem;font-weight:300;line-height:1.9;color:var(--text-muted);margin-bottom:1.1rem}
.about-tagline{margin-top:2rem;padding-top:2rem;border-top:1px solid var(--border);font-family:'Cormorant Garamond',serif;font-size:1.1rem;font-style:italic;color:var(--copper)}
.about-visual{position:relative;display:flex;align-items:center;justify-content:center}
.about-float{position:absolute;top:-20px;right:-20px;width:100px;height:100px;border:1px solid rgba(181,114,42,.25);border-radius:50%}
.about-float2{position:absolute;bottom:-30px;left:-30px;width:160px;height:160px;border:1px solid rgba(181,114,42,.12);border-radius:50%}
.about-card{width:100%;aspect-ratio:3/4;max-width:320px;background:linear-gradient(145deg,var(--dark-mid),var(--dark));border:1px solid var(--border);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1.5rem;padding:3rem;position:relative;overflow:hidden}
.about-card::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at top right,rgba(181,114,42,.15),transparent 60%)}
.about-card-icon{width:70px;height:70px;border:1px solid rgba(181,114,42,.4);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.8rem;color:var(--copper-light);position:relative;z-index:1}
.about-card-title{font-family:'Cormorant Garamond',serif;font-size:1.4rem;font-weight:300;color:#f5ede2;text-align:center;position:relative;z-index:1}
.about-card-text{text-align:center;position:relative;z-index:1;color:rgba(245,237,226,.6);font-size:.8rem;font-weight:300;line-height:1.8}
.about-card-dots{font-size:.6rem;letter-spacing:.22em;text-transform:uppercase;color:rgba(181,114,42,.5);position:relative;z-index:1}

/* ── WHY COPPER ── */
.why{background:var(--dark);padding:8rem 8%;position:relative;overflow:hidden}
.why::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 80% 20%,rgba(181,114,42,.1),transparent 55%),radial-gradient(ellipse at 10% 80%,rgba(74,124,78,.06),transparent 55%)}
.why-header{text-align:center;margin-bottom:5rem;position:relative;z-index:1}
.why-header .section-tag{justify-content:center}
.why-header .section-tag::before{display:none}
.why-header .section-title{color:#f5ede2}
.why-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;position:relative;z-index:1}
.why-card{
  padding:2.8rem 2rem;background:rgba(255,255,255,.03);
  border:1px solid rgba(181,114,42,.14);position:relative;overflow:hidden;
  transition:background .4s,transform .3s;cursor:default;
}
.why-card:hover{background:rgba(181,114,42,.07);transform:translateY(-4px)}
.why-card::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:linear-gradient(to right,var(--copper),transparent);opacity:0;transition:opacity .4s}
.why-card:hover::after{opacity:1}
.why-icon{font-size:2.2rem;margin-bottom:1.2rem}
.why-card h3{font-family:'Cormorant Garamond',serif;font-size:1.35rem;font-weight:300;color:#f5ede2;margin-bottom:.8rem}
.why-card p{font-size:.83rem;font-weight:300;line-height:1.85;color:rgba(245,237,226,.5)}
.why-card .tag{display:inline-block;margin-top:1rem;font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;color:var(--copper);border:1px solid rgba(181,114,42,.3);padding:.25rem .7rem}

/* ── DOSHA ── */
.dosha{background:var(--cream);padding:8rem 8%}
.dosha-header{text-align:center;margin-bottom:4rem}
.dosha-header .section-tag{justify-content:center}
.dosha-header .section-tag::before{display:none}
.dosha-intro{max-width:560px;margin:0 auto;font-size:.9rem;font-weight:300;line-height:1.9;color:var(--text-muted);text-align:center;margin-bottom:3rem}
.dosha-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}
.dosha-card{
  padding:3rem 2rem;border:1px solid var(--border);background:#fff;
  text-align:center;position:relative;overflow:hidden;
  transition:box-shadow .4s,transform .3s;cursor:pointer;
}
.dosha-card:hover{box-shadow:0 20px 60px rgba(181,114,42,.12);transform:translateY(-4px)}
.dosha-card.active{border-color:var(--copper);background:linear-gradient(160deg,#fff9f4,#fff)}
.dosha-card.active::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--copper)}
.dosha-emoji{font-size:2.8rem;margin-bottom:1rem}
.dosha-name{font-family:'Cormorant Garamond',serif;font-size:1.7rem;font-weight:300;color:var(--dark);margin-bottom:.3rem}
.dosha-element{font-size:.65rem;letter-spacing:.22em;text-transform:uppercase;color:var(--copper);margin-bottom:1rem}
.dosha-desc{font-size:.82rem;font-weight:300;line-height:1.8;color:var(--text-muted);margin-bottom:1.2rem}
.dosha-product{font-size:.75rem;font-weight:400;color:var(--copper-dark);border:1px solid var(--border);padding:.4rem 1rem;display:inline-block}
.dosha-result{
  margin-top:3rem;padding:2.5rem 3rem;
  background:var(--dark);border-left:3px solid var(--copper);
  display:none;
}
.dosha-result.show{display:block}
.dosha-result p{font-family:'Cormorant Garamond',serif;font-size:1.2rem;font-weight:300;font-style:italic;color:#f5ede2;line-height:1.7}
.dosha-result span{color:var(--copper-light)}

/* ── QUIZ ── */
.quiz-section{background:var(--warm-white);padding:8rem 8%}
.quiz-wrap{max-width:680px;margin:0 auto}
.quiz-header{text-align:center;margin-bottom:3.5rem}
.quiz-header .section-tag{justify-content:center}
.quiz-header .section-tag::before{display:none}
.quiz-progress-bar{height:2px;background:var(--border);margin-bottom:3rem;position:relative;overflow:hidden}
.quiz-progress-fill{height:100%;background:var(--copper);transition:width .5s ease;width:0%}
.quiz-step{display:none}
.quiz-step.active{display:block;animation:fadeUp .4s ease}
.quiz-q{font-family:'Cormorant Garamond',serif;font-size:1.8rem;font-weight:300;color:var(--dark);margin-bottom:.6rem;line-height:1.3}
.quiz-sub{font-size:.83rem;font-weight:300;color:var(--text-muted);margin-bottom:2rem}
.quiz-options{display:grid;grid-template-columns:1fr 1fr;gap:.9rem;margin-bottom:2.5rem}
.quiz-opt{
  padding:1.1rem 1.4rem;border:1px solid var(--border);background:#fff;
  text-align:left;cursor:pointer;transition:border-color .3s,background .3s;
  font-family:'Jost',sans-serif;font-size:.85rem;font-weight:300;color:var(--text-body);
}
.quiz-opt:hover{border-color:var(--copper);background:rgba(181,114,42,.04)}
.quiz-opt.selected{border-color:var(--copper);background:rgba(181,114,42,.08)}
.quiz-opt-icon{font-size:1.3rem;display:block;margin-bottom:.4rem}
.quiz-nav{display:flex;justify-content:space-between;align-items:center}
.quiz-result{display:none;text-align:center;padding:2rem}
.quiz-result.show{display:block;animation:fadeUp .5s ease}
.quiz-result-icon{font-size:3.5rem;margin-bottom:1rem}
.quiz-result h3{font-family:'Cormorant Garamond',serif;font-size:2.2rem;font-weight:300;color:var(--dark);margin-bottom:.8rem}
.quiz-result p{font-size:.9rem;font-weight:300;line-height:1.9;color:var(--text-muted);margin-bottom:2rem;max-width:440px;margin-left:auto;margin-right:auto}
.quiz-restart{font-size:.72rem;font-weight:300;letter-spacing:.18em;text-transform:uppercase;color:var(--text-muted);background:none;border:none;cursor:pointer;font-family:'Jost',sans-serif;margin-top:1rem;text-decoration:underline}

/* ── MISSION VISION ── */
.mv{background:var(--dark);padding:8rem 8%;position:relative;overflow:hidden}
.mv::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 20% 80%,rgba(181,114,42,.1),transparent 50%),radial-gradient(ellipse at 80% 20%,rgba(74,124,78,.07),transparent 50%)}
.mv-header{text-align:center;margin-bottom:5rem;position:relative;z-index:1}
.mv-header .section-tag{justify-content:center}
.mv-header .section-tag::before{display:none}
.mv-header .section-title{color:#f5ede2}
.mv-grid{display:grid;grid-template-columns:1fr 1fr;gap:2px;position:relative;z-index:1}
.mv-card{padding:4rem;background:rgba(255,255,255,.03);border:1px solid rgba(181,114,42,.15);position:relative;overflow:hidden;transition:background .4s}
.mv-card:hover{background:rgba(181,114,42,.06)}
.mv-card::after{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(to right,var(--copper),transparent);opacity:0;transition:opacity .4s}
.mv-card:hover::after{opacity:1}
.mv-number{font-family:'Cormorant Garamond',serif;font-size:5rem;font-weight:300;color:rgba(181,114,42,.1);line-height:1;margin-bottom:.5rem}
.mv-label{font-size:.7rem;font-weight:400;letter-spacing:.25em;text-transform:uppercase;color:var(--copper);margin-bottom:1.5rem}
.mv-card h3{font-family:'Cormorant Garamond',serif;font-size:1.9rem;font-weight:300;color:#f5ede2;margin-bottom:1.2rem}
.mv-card ul{list-style:none}
.mv-card ul li{font-size:.87rem;font-weight:300;line-height:1.85;color:rgba(245,237,226,.55);padding:.6rem 0;border-bottom:1px solid rgba(181,114,42,.1);display:flex;gap:.8rem;align-items:flex-start}
.mv-card ul li::before{content:'—';color:var(--copper);flex-shrink:0}

/* ── GOALS ── */
.goals{background:var(--warm-white);padding:8rem 8%}
.goals-header{margin-bottom:5rem}
.goals-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}
.goal-card{padding:3rem 2.5rem;border:1px solid var(--border);position:relative;overflow:hidden;transition:box-shadow .4s,transform .3s;background:#fff}
.goal-card:hover{box-shadow:0 20px 60px rgba(181,114,42,.12);transform:translateY(-4px)}
.goal-num{font-family:'Cormorant Garamond',serif;font-size:4.5rem;font-weight:300;color:rgba(181,114,42,.1);line-height:1;margin-bottom:-.5rem}
.goal-label{font-size:.65rem;font-weight:500;letter-spacing:.25em;text-transform:uppercase;color:var(--copper);margin-bottom:.8rem}
.goal-card h3{font-family:'Cormorant Garamond',serif;font-size:1.5rem;font-weight:400;color:var(--dark);margin-bottom:1rem}
.goal-card p{font-size:.87rem;font-weight:300;line-height:1.85;color:var(--text-muted)}
.goal-bar{position:absolute;bottom:0;left:0;height:3px;background:var(--copper);width:0;transition:width .5s ease}
.goal-card:hover .goal-bar{width:100%}

/* ── JOURNAL (BLOG) ── */
.journal{background:var(--cream);padding:8rem 8%}
.journal-header{margin-bottom:4rem;display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:1.5rem}
.journal-link{font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;color:var(--copper);text-decoration:none;display:flex;align-items:center;gap:.5rem}
.journal-link::after{content:'→'}
.journal-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}
.journal-card{background:#fff;border:1px solid var(--border);overflow:hidden;transition:box-shadow .4s,transform .3s}
.journal-card:hover{box-shadow:0 16px 50px rgba(181,114,42,.1);transform:translateY(-3px)}
.journal-img{height:180px;display:flex;align-items:center;justify-content:center;font-size:3.5rem;position:relative;overflow:hidden}
.journal-img-1{background:linear-gradient(135deg,#2e2418,#4a3020)}
.journal-img-2{background:linear-gradient(135deg,#1a2818,#2a3d2a)}
.journal-img-3{background:linear-gradient(135deg,#1a1828,#2a2840)}
.journal-body{padding:1.8rem}
.journal-cat{font-size:.62rem;letter-spacing:.22em;text-transform:uppercase;color:var(--copper);margin-bottom:.7rem}
.journal-card h3{font-family:'Cormorant Garamond',serif;font-size:1.25rem;font-weight:300;color:var(--dark);margin-bottom:.7rem;line-height:1.35}
.journal-card p{font-size:.8rem;font-weight:300;line-height:1.75;color:var(--text-muted);margin-bottom:1.2rem}
.journal-meta{font-size:.68rem;color:rgba(140,115,85,.6);letter-spacing:.05em}

/* ── INSTAGRAM FEED ── */
.insta{background:var(--dark);padding:6rem 8%;text-align:center}
.insta-header{margin-bottom:3rem}
.insta-handle{font-family:'Cormorant Garamond',serif;font-size:1.8rem;font-weight:300;color:#f5ede2}
.insta-handle span{color:var(--copper)}
.insta-sub{font-size:.78rem;font-weight:300;letter-spacing:.12em;color:rgba(245,237,226,.45);margin-top:.4rem}
.insta-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:4px;margin-bottom:2.5rem}
.insta-tile{aspect-ratio:1;position:relative;overflow:hidden;cursor:pointer}
.insta-tile-bg{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:2rem;transition:transform .4s}
.insta-tile:hover .insta-tile-bg{transform:scale(1.08)}
.insta-tile-overlay{position:absolute;inset:0;background:rgba(181,114,42,.7);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .3s;font-size:.7rem;letter-spacing:.15em;text-transform:uppercase;color:#fff}
.insta-tile:hover .insta-tile-overlay{opacity:1}
.i1{background:linear-gradient(135deg,#3d2f1f,#5a4025)}
.i2{background:linear-gradient(135deg,#2a3520,#3d5030)}
.i3{background:linear-gradient(135deg,#3d1f1f,#5a2525)}
