<script>
// ── SCROLL REVEAL ──
const reveals = document.querySelectorAll('.reveal');
const obs = new IntersectionObserver(entries => {
  entries.forEach((e,i) => {
    if(e.isIntersecting){
      setTimeout(()=>e.target.classList.add('visible'), i*80);
      obs.unobserve(e.target);
    }
  });
},{threshold:0.1});
reveals.forEach(r=>obs.observe(r));

// ── BOTTLE WATER FILL ──
const heroVisual = document.querySelector('.hero-visual');
const waterRect = document.getElementById('waterRect');
const waterLine = document.getElementById('waterLine');
let filled = false;
heroVisual.addEventListener('mouseenter',()=>{
  waterRect.setAttribute('y','70');
  waterRect.setAttribute('height','220');
  waterLine.setAttribute('y','68');
  filled=true;
});
heroVisual.addEventListener('mouseleave',()=>{
  waterRect.setAttribute('y','150');
  waterRect.setAttribute('height','140');
  waterLine.setAttribute('y','148');
  filled=false;
});
// animate fill on scroll into view
const bottleObs = new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      setTimeout(()=>{
        waterRect.setAttribute('y','100'); waterRect.setAttribute('height','190');
        waterLine.setAttribute('y','98');
      },600);
    }
  });
},{threshold:0.5});
bottleObs.observe(heroVisual);

// ── DOSHA ──
function selectDosha(type, el){
  document.querySelectorAll('.dosha-card').forEach(c=>c.classList.remove('active'));
  el.classList.add('active');
  const msgs = {
    vata:`Your <span>Vata</span> nature craves grounding and regularity. Start every morning with a tall glass of Tamra Jal — water stored overnight in your TamraLife copper bottle. This practice calms Vata's restless energy and kindles your digestive fire (Agni) for the day ahead.`,
    pitta:`As a <span>Pitta</span> type, you run warm. Copper water consumed at room temperature helps cool excess fire in the body. Pair a TamraLife copper cup with a cooling mint or rose petal infusion each evening to restore balance and ease inflammation.`,
    kapha:`Your <span>Kapha</span> constitution benefits from stimulation and warmth. Drink warm Tamra Jal first thing each morning to fire up a naturally slow metabolism. Copper's energizing properties help Kapha types feel lighter, clearer, and more motivated throughout the day.`
  };
  const res = document.getElementById('doshaResult');
  document.getElementById('doshaResultText').innerHTML = msgs[type];
  res.classList.add('show');
  res.scrollIntoView({behavior:'smooth',block:'nearest'});
}

// ── QUIZ ──
const answers={};
function selectOpt(el,key,val){
  el.closest('.quiz-options').querySelectorAll('.quiz-opt').forEach(o=>o.classList.remove('selected'));
  el.classList.add('selected');
  answers[key]=val;
}
function nextStep(n){
  document.querySelectorAll('.quiz-step').forEach(s=>s.classList.remove('active'));
  document.getElementById('step'+n).classList.add('active');
  document.getElementById('quizProgress').style.width=(((n-1)/3)*100)+'%';
}
function prevStep(n){nextStep(n)}
function showResult(){
  document.getElementById('quizProgress').style.width='100%';
  document.querySelectorAll('.quiz-step').forEach(s=>s.classList.remove('active'));
  const res = document.getElementById('quizResult');
  res.classList.add('show');
  // compute result based on answers
  const goal = answers.goal||'energy';
  const hydrate = answers.hydrate||'bottle';
  const results = {
    digestion:{icon:'🌿',title:'The Gut Reset Ritual',desc:'Your body is calling for deep nourishment. Begin each morning with 300ml of Tamra Jal — water stored overnight in your TamraLife copper bottle. Pair with warm lemon water and notice the difference in your digestion within 2 weeks.'},
    energy:{icon:'⚡',title:'The Morning Ignite Ritual',desc:'You thrive on vitality. Start your day by drinking Tamra Jal on an empty stomach before 7am. Copper activates your body\'s natural energy production at a cellular level — no caffeine required.'},
    immunity:{icon:'🛡️',title:'The Immunity Shield Ritual',desc:'Your body wants protection. The antimicrobial properties of copper silently purify your water as you sleep. Make TamraLife your nightly ritual — fill, rest, and wake up to supercharged water.'},
    calm:{icon:'🧘',title:'The Evening Peace Ritual',desc:'Stillness is your superpower. Wind down with a copper cup of warm water and a pinch of ashwagandha before bed. Copper\'s natural grounding energy aligns perfectly with your need for calm.'},
  };
  const r = results[goal];
  document.getElementById('resultIcon').textContent=r.icon;
  document.getElementById('resultTitle').textContent=r.title;
  document.getElementById('resultDesc').textContent=r.desc;
}
function restartQuiz(){
  Object.keys(answers).forEach(k=>delete answers[k]);
  document.getElementById('quizResult').classList.remove('show');
  document.getElementById('quizProgress').style.width='0%';
  document.querySelectorAll('.quiz-opt').forEach(o=>o.classList.remove('selected'));
  nextStep(1);
}
</script>
